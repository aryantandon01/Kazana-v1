# Public (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=random-secret-for-vercel-cron

# Job extraction (optional LLM escalation — skipped when unset)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# EXTRACTION_CONFIDENCE_THRESHOLD=0.7

# Optional observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Credit-system integration tests (npm run test:integration) — dedicated test project only
# TEST_SUPABASE_URL=https://your-test-project.supabase.co
# TEST_SUPABASE_ANON_KEY=your-test-anon-key
# TEST_SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# Staging (copy to .env.staging on Vercel preview)
# NEXT_PUBLIC_SUPABASE_URL=https://staging-project.supabase.co

# Mobile (apps/mobile/.env)
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Database (migration runner — direct connection, port 5432)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres

# Background workers (docker compose / container host)
# SUPABASE_URL=          # defaults to NEXT_PUBLIC_SUPABASE_URL
# WORKER_INGEST_CONCURRENCY=8
# WORKER_INGEST_COOLDOWN_MINUTES=5
# WORKER_PULSE_MINUTES=5
# WORKER_MATCH_LOOKBACK_HOURS=2
# WORKER_NOTIFY_LIMIT=200

# WhatsApp notifications (dormant until configured)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_JOB_MATCH_TEMPLATE=job_match_alert
# WHATSAPP_TEMPLATE_LANGUAGE=en
